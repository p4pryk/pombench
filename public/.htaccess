# Standalone static pages; unknown routes must return a real 404.
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset utf-8
AddCharset utf-8 .html .md .txt .json .xml .svg
AddType text/markdown .md
AddType image/webp .webp
AddType image/avif .avif
AddType image/x-icon .ico
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS and non-www first, one hop, no port in the Location.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://pombench.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.pombench\.com$ [NC]
  RewriteRule ^ https://pombench.com%{REQUEST_URI} [R=301,L,NE]

  # /index.html duplicates -> the folder URL (/, /compare/, /method/, /animations/<slug>/).
  RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://pombench.com/$1 [R=301,L,NC]

  # /animations/ has no index of its own.
  RewriteRule ^animations/?$ https://pombench.com/ [R=301,L]

# --- Model page slug migration: old /animations/ or legacy /models/ URL (any case, dot or dash) -> new lowercase-dash URL ---
RewriteCond %{REQUEST_URI} !^/animations/claude-haiku-4-5/$
RewriteRule ^(?:animations|models)/claude[.-]haiku[.-]4[.-]5/?$ https://pombench.com/animations/claude-haiku-4-5/ [R=301,NC,L]
