RewriteCond %{REQUEST_URI} !^/animations/claude-fable-5-1/$
RewriteRule ^(?:animations|models)/claude[.-]fable[.-]5[.-]1/?$ https://pombench.com/animations/claude-fable-5-1/ [R=301,NC,L]
