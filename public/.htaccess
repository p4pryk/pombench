# Apache configuration for the standalone PomBench website.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
</IfModule>
<FilesMatch "\.txt$">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
  </IfModule>
</FilesMatch>
<IfModule mod_authz_core.c>
  <FilesMatch "^(?:\.env(?:\..*)?|.*\.(?:key|pem|p12|pfx))$">
    Require all denied
  </FilesMatch>
</IfModule>
