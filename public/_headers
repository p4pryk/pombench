/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/results/*/source.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment

/results/*.json
  X-Robots-Tag: noindex
/results/*.md
  X-Robots-Tag: noindex
/results/*/*.txt
  X-Robots-Tag: noindex
/results/*/*.json
  X-Robots-Tag: noindex
