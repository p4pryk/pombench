# Only the standalone website and its public evidence belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/playwright.config.ts
!/src/
!/public/
!/docs/
!/scripts/
/scripts/*
!/scripts/check-build.mjs
!/scripts/check-secrets.mjs
!/scripts/sanitize-public.mjs
!/scripts/smoke-build.mjs
!/scripts/build-seo-assets.mjs
!/tests/
/tests/*
!/tests/catalog.test.ts
!/tests/seo.test.ts
!/tests/outcome.test.ts
!/tests/public-results.test.ts
!/tests/browser/
/tests/browser/*
!/tests/browser/app.spec.ts

# Never publish private configuration, credentials or local artifacts.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.DS_Store
**/__pycache__/
**/*.writing
