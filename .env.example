# Optional private tooling configuration. The public website reads none of these.
# Copy to .env locally. Never prefix private variables with VITE_.
# Leave real keys, account identifiers and inference endpoints out of Git.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_FOUNDRY_ACCOUNT=

# Optional Google Vertex AI generation (never read by the public website).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
