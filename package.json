{
  "name": "pombench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "build": "npm run check:secrets && tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test:production": "node scripts/smoke-build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
